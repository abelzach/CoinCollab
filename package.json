{
  "name": "coincollab",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "account": "yarn workspace @coincollab/foundry account",
    "backend:start": "yarn workspace @coincollab/backend start",
    "chain": "yarn workspace @coincollab/foundry chain",
    "compile": "yarn workspace @coincollab/foundry compile",
    "compile:circuits": "yarn workspace @coincollab/foundry compile:circuits",
    "deploy": "yarn workspace @coincollab/foundry deploy",
    "deploy:verify": "yarn workspace @coincollab/foundry deploy:verify",
    "fork": "yarn workspace @coincollab/foundry fork",
    "foundry:lint": "yarn workspace @coincollab/foundry lint",
    "foundry:test": "yarn workspace @coincollab/foundry test",
    "generate": "yarn workspace @coincollab/foundry generate",
    "postinstall": "husky install",
    "next:check-types": "yarn workspace @coincollab/nextjs check-types",
    "next:format": "yarn workspace @coincollab/nextjs format",
    "next:lint": "yarn workspace @coincollab/nextjs lint",
    "precommit": "lint-staged",
    "prepare": "install-self-peers -- --ignore-scripts",
    "showrunners:docker": "yarn workspace @rosca/showrunners docker",
    "showrunners:start": "yarn workspace @rosca/showrunners start",
    "start": "yarn workspace @coincollab/nextjs dev",
    "test": "yarn foundry:test",
    "vercel": "yarn workspace @coincollab/nextjs vercel",
    "vercel:yolo": "yarn workspace @coincollab/nextjs vercel:yolo",
    "verify": "yarn workspace @coincollab/foundry verify"
  },
  "resolutions": {
    "usehooks-ts@^2.7.2": "patch:usehooks-ts@npm:^2.7.2#./.yarn/patches/usehooks-ts-npm-2.7.2-fceffe0e43.patch"
  },
  "devDependencies": {
    "husky": "~8.0.3",
    "lint-staged": "~13.2.2"
  },
  "packageManager": "yarn@3.2.3"
}
